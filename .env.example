# Copy to .env.local and fill from Firebase Console:
# Project settings → Your apps → Web app → Firebase SDK snippet
# (Same project as the wellnessXplora website — client/public config only.)

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional for native Google (Expo Go / device). Not required for Google in the browser.
# Firebase Console → Authentication → Sign-in method → Google → Web SDK configuration → Web client ID
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Later (development build): iOS / Android OAuth client IDs from Google Cloud Console
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
